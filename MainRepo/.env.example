# Copy to .env (never commit .env)
# Shared salt for hashing premise numbers and device keys. EVERYONE uses the same value (get it from team chat),
# so home ids match across machines and data/demo_homes.json works.
CONCIERGE_SALT=change-me
# Optional override of the database path
# CONCIERGE_DB=data/outage_concierge.db
# Lane D chat: API key with credits from console.anthropic.com (Claude Pro does not include API access)
ANTHROPIC_API_KEY=
# Lane D chat now uses Gemini: free key from aistudio.google.com
GEMINI_API_KEY=
# Frontend (put in frontend/.env.local)
# VITE_API_BASE=http://localhost:8000
